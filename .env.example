# Postgres connection string used by the scraper and (later) the API.
# Local dev (embedded Postgres via `node scripts/dev-db.mjs`):
SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:5544/wildrift_forge
# Supabase (Project Settings -> Database -> Connection string, URI format):
# SUPABASE_DB_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
