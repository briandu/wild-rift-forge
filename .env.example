# Postgres connection string used by the scraper and (later) the API.
# Local dev (embedded Postgres via `node scripts/dev-db.mjs`):
SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:5544/wild_rift_forge
# Supabase — prefer Session pooler (IPv4). GitHub Actions cannot reach the
# direct db.*.supabase.co host (IPv6-only). Dashboard → Connect → Session mode:
# SUPABASE_DB_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres
