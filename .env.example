# Postgres connection string used by the scraper and API.
# Local dev (embedded Postgres via `node scripts/dev-db.mjs`):
SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:5544/wild_rift_forge
# Supabase — prefer Session pooler (IPv4). GitHub Actions cannot reach the
# direct db.*.supabase.co host (IPv6-only). Dashboard → Connect → Session mode:
# SUPABASE_DB_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres

# Supabase API (required for Storage asset sync — scraper only).
# Dashboard → Settings → API
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Express API (apps/api)
# API_PORT=4000

# Next.js web (apps/web) — copy into apps/web/.env.local if needed
# NEXT_PUBLIC_API_URL=http://localhost:4000
