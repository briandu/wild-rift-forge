# Postgres connection string used by the scraper and API.
# Local dev (embedded Postgres via `node scripts/dev-db.mjs`):
SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:5544/wild_rift_forge
# Supabase — prefer Session pooler (IPv4). GitHub Actions cannot reach the
# direct db.*.supabase.co host (IPv6-only). Dashboard → Connect → Session mode:
# SUPABASE_DB_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres

# Supabase API (required for Storage asset sync — scraper only).
# Dashboard → Settings → API
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional. Used by scrape:analyze-patch, scrape:tiers-explain, scrape:matchups-generate.
# OPENAI_API_KEY=sk-...
# Override the explainer model (default gpt-5.6-sol).
# OPENAI_TIER_EXPLAIN_MODEL=gpt-5.6-sol
# Matchup guides: gpt-5.6-sol + high reasoning. Only spent when a pairing is missing
# or a kit/rework actually changed — number-only patches reuse stored punish copy.
# OPENAI_MATCHUP_MODEL=gpt-5.6-sol
# OPENAI_MATCHUP_REASONING=high
# Spend caps. Extra views stay queued until the next hour/day window.
# OPENAI_MATCHUP_CONCURRENCY=2
# OPENAI_MATCHUP_HOURLY_LIMIT=8
# OPENAI_MATCHUP_DAILY_LIMIT=40
# Set to off to stop all matchup OpenAI calls without removing the key.
# OPENAI_MATCHUP_GENERATION=on

# Auth emails (hosted Supabase). Custom HTML is blocked until SMTP is set.
# RESEND_API_KEY=re_...
# SMTP_FROM=auth@your-domain.com
# SUPABASE_ACCESS_TOKEN=sbp_...   # Dashboard → Account → Access Tokens
# Then: node scripts/configure-resend-smtp.mjs && node scripts/push-auth-email-templates.mjs

# Riot Sign-On (optional). Without these, /me stores a Riot ID string instead.
# RIOT_CLIENT_ID=
# RIOT_CLIENT_SECRET=
# NEXT_PUBLIC_RIOT_CLIENT_ID=
# RIOT_REDIRECT_URI=http://localhost:3001/auth/riot/callback

# Weekly digest sender (GitHub Action secrets + Resend)
# SITE_URL=https://www.wildriftforge.com

# Express API (apps/api)
# API_PORT=4000

# Next.js web (apps/web) — copy into apps/web/.env.local
# NEXT_PUBLIC_API_URL=http://localhost:4000
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-legacy-anon-jwt
#
# Vercel production (Project Settings → Environment Variables):
#   SUPABASE_DB_URL                     session pooler URI (server-only)
#   NEXT_PUBLIC_SUPABASE_URL            same as local
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
#   NEXT_PUBLIC_SITE_URL=https://www.wildriftforge.com
# Do not set NEXT_PUBLIC_API_URL on Vercel — the web app queries Postgres directly.
# Do not set NEXT_PUBLIC_SITE_URL locally — OAuth uses the current origin and port.
