{
  "name": "wild-rift-forge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "npm run --workspace @wild-rift-forge/web dev",
    "dev:api": "npm run --workspace @wild-rift-forge/api dev",
    "build:web": "npm run --workspace @wild-rift-forge/web build",
    "scrape:latest": "npm run --workspace @wild-rift-forge/scraper latest",
    "scrape:backfill": "npm run --workspace @wild-rift-forge/scraper backfill --",
    "scrape:champions": "npm run --workspace @wild-rift-forge/scraper champions --",
    "scrape:champion-assets": "npm run --workspace @wild-rift-forge/scraper champion-assets --",
    "scrape:champion-thumbnails": "npm run --workspace @wild-rift-forge/scraper champion-thumbnails --",
    "scrape:stats": "npm run --workspace @wild-rift-forge/scraper stats",
    "scrape:analyze-patch": "npm run --workspace @wild-rift-forge/scraper analyze-patch --",
    "design:ingest": "node scripts/ingest-claude-design.mjs",
    "design:preview": "node scripts/preview-claude-design.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && npm run --workspace @wild-rift-forge/web typecheck && npm run --workspace @wild-rift-forge/api typecheck",
    "emails:smtp": "node scripts/configure-resend-smtp.mjs",
    "emails:push": "node scripts/push-auth-email-templates.mjs",
    "emails:digest": "node scripts/send-weekly-digest.mjs",
    "emails:alerts": "node scripts/send-account-alerts.mjs",
    "wrf:scrape": "tsx scripts/wildriftfire/scrape-champions.ts",
    "wrf:scrape-one": "tsx scripts/wildriftfire/scrape-champion.ts",
    "wrf:validate": "tsx scripts/wildriftfire/validate-scrape.ts",
    "wrf:diff": "tsx scripts/wildriftfire/diff-snapshots.ts",
    "wrf:import": "tsx scripts/wildriftfire/import-gameplay.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
