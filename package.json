{
  "name": "wildrift-forge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "scrape:latest": "npm run --workspace @wildrift-forge/scraper latest",
    "scrape:backfill": "npm run --workspace @wildrift-forge/scraper backfill --",
    "scrape:champions": "npm run --workspace @wildrift-forge/scraper champions --",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
